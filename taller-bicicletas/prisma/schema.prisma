generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// CONFIGURACIÓN DE EMPRESA
// ═══════════════════════════════════════════════════════════════
model Empresa {
  id            Int      @id @default(autoincrement())
  nombre        String
  cif           String
  direccion     String
  codigoPostal  String
  ciudad        String
  provincia     String
  telefono      String
  email         String
  web           String?
  logoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// USUARIOS (Multiusuario)
// ═══════════════════════════════════════════════════════════════
model Usuario {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  password         String
  nombre           String
  rol              String    @default("mecanico") // admin, mecandministrador
  activo           Boolean   @default(true)
  pinHash          String?
  pinIntentos      Int       @default(0)
  pinBloqueadoHasta DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// MECÁNICOS (Lista propia del taller, gestionada en Configuración)
// ═══════════════════════════════════════════════════════════════
model Mecanico {
  id            Int       @id @default(autoincrement())
  nombre        String    @unique
  activo        Boolean   @default(true)
  agendaTramos  String?   // JSON [{inicio,fin}] propio en la agenda; null = el del taller
  agendaHorasMaximas Float? // null = las del taller
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones
  ordenes       OrdenReparacion[]
  agendaTrabajos AgendaTrabajo[]
}

// ═══════════════════════════════════════════════════════════════
// AJUSTES DE LA APLICACIÓN (Pares clave/valor, valor en JSON)
// ═══════════════════════════════════════════════════════════════
model Ajuste {
  clave         String    @id
  valor         String
  updatedAt     DateTime  @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// CLIENTES
// ═══════════════════════════════════════════════════════════════
model Cliente {
  id            Int         @id @default(autoincrement())
  numeroCliente Int         @unique
  codigoFactusol Int?       // Código del cliente en Factusol (5 cifras); en los importados coincide con numeroCliente
  nombre        String
  apellidos     String?
  dni           String?
  direccion     String?
  codigoPostal  String?
  poblacion     String?
  provincia     String?
  telefono      String?
  email         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relaciones
  bicicletas    Bicicleta[]
  ordenes       OrdenReparacion[]
  agendaTrabajos AgendaTrabajo[]

  @@index([nombre])
  @@index([numeroCliente])
}

// ═══════════════════════════════════════════════════════════════
// BICICLETAS
// ═══════════════════════════════════════════════════════════════
model Bicicleta {
  id            Int       @id @default(autoincrement())
  clienteId     Int
  marca         String
  modelo        String?
  color         String?
  numeroSerie   String?
  tamano        String?
  anio          Int?
  tipo          String    @default("Carretera") // BiciInfantil, XC, Trail, Enduro, Descens, Passeig, Gravel, Carretera, Triatlo, EBikePasseig, EBikeXC, EBikeEnduro, EBikeGravel, EBikeCarretera
  observaciones String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones
  cliente       Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ordenes       OrdenReparacion[]

  @@index([clienteId])
  @@index([numeroSerie])
}

// ═══════════════════════════════════════════════════════════════
// ARTÍCULOS (Catálogo de materiales)
// ═══════════════════════════════════════════════════════════════
model Articulo {
  id            Int       @id @default(autoincrement())
  referencia    String    @unique
  descripcion   String
  precioCompra  Float     @default(0)
  precioVenta   Float     @default(0)
  iva           Float     @default(21) // 21, 10, 4, 0
  stock         Float     @default(0)
  sinStockDesde DateTime? // Desde cuándo está sin stock (stock <= 0); null si hay existencias
  familia       String?
  proveedor     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones
  ordenes       OrdenMaterial[]

  @@index([referencia])
  @@index([descripcion])
  @@index([familia])
  @@index([sinStockDesde])
}

// ═══════════════════════════════════════════════════════════════
// ÓRDENES DE REPARACIÓN
// ═══════════════════════════════════════════════════════════════
model OrdenReparacion {
  id                Int       @id @default(autoincrement())
  numeroOrden       String    @unique
  clienteId         Int
  bicicletaId       Int?
  fechaEntrada      DateTime  @default(now())
  fechaPrevista     DateTime?
  fechaFinalizacion DateTime? // Se fija (la primera vez) al pasar a estado Finalizada o Entregada
  estado            String    @default("Admision") // Admision, EnReparacion, EnPausa, EsperandoMaterial, Finalizada, Entregada, Biomecanica
  descripcion       String?   // Trabajos realizados
  diagnostico       String?
  recomendaciones   String?
  observaciones     String?   // Observaciones internas (no se imprimen)
  accesorios        String?   // Accesorios entregados con la bicicleta
  problema          String?   // Indicaciones del cliente sobre lo que le pasa a la bicicleta
  garantia          Boolean   @default(false) // Si la reparación está en garantía
  tipoReparacion    String?   // Preferente, Programada, Urgente, NoProgramada
  formaPago         String?   // Pendiente, Parcial, Efectivo, Tarjeta, Bizum, Transferencia (interno, no se imprime)
  estadoPago        String?   // OBSOLETO: su valor se unificó en formaPago; no usar (columna conservada por compatibilidad)
  mecanicoId        Int?      // Mecánico asignado
  seguimiento       String?   // Seguimiento interno: cliente avisado, falta un dato o una pieza...
  clienteAvisado    Boolean   @default(false) // Casilla rápida: cliente avisado

  // Cálculos
  subtotalMateriales Float    @default(0)
  subtotalManoObra   Float    @default(0)
  descuentoGlobal   Float    @default(0) // Porcentaje
  baseImponible     Float    @default(0)
  iva               Float    @default(0)
  total             Float    @default(0)

  // Factusol (exportación a la contabilidad)
  exportadaFactusolEn DateTime? // Cuándo se exportó la orden a Factusol
  albaranFactusol     String?   // Referencia del albarán creado en Factusol

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relaciones
  cliente           Cliente   @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  bicicleta         Bicicleta? @relation(fields: [bicicletaId], references: [id], onDelete: Restrict)
  mecanico          Mecanico? @relation(fields: [mecanicoId], references: [id], onDelete: Restrict)
  materiales        OrdenMaterial[]
  manoObra          OrdenManoObra[]
  agendaTrabajos    AgendaTrabajo[]

  @@index([numeroOrden])
  @@index([clienteId])
  @@index([estado])
  @@index([fechaEntrada])
  @@index([mecanicoId])
}

// ═══════════════════════════════════════════════════════════════
// MATERIALES DE LA ORDEN (Línea de materiales)
// ═══════════════════════════════════════════════════════════════
model OrdenMaterial {
  id            Int       @id @default(autoincrement())
  ordenId       Int
  articuloId    Int?
  referencia    String
  descripcion   String
  cantidad      Float     @default(1)
  precioUnitario Float    @default(0)
  descuento     Float     @default(0) // Porcentaje
  precioNeto    Float     @default(0)
  iva           Float     @default(21)
  importeTotal  Float     @default(0)

  // Relaciones
  orden         OrdenReparacion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  articulo      Articulo?  @relation(fields: [articuloId], references: [id], onDelete: SetNull)

  @@index([ordenId])
}

// ═══════════════════════════════════════════════════════════════
// MANO DE OBRA DE LA ORDEN
// ═══════════════════════════════════════════════════════════════
model OrdenManoObra {
  id            Int       @id @default(autoincrement())
  ordenId       Int
  codigoOp      String
  descripcion   String
  tiempo        Float     @default(0) // En horas
  precioHora    Float     @default(0)
  importe       Float     @default(0)

  // Relaciones
  orden         OrdenReparacion @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  agendaTrabajos AgendaTrabajo[]

  @@index([ordenId])
}

// ═══════════════════════════════════════════════════════════════
// OPERACIONES DE MANO DE OBRA (Catálogo predefinido)
// ═══════════════════════════════════════════════════════════════
model OperacionManoObra {
  id            Int       @id @default(autoincrement())
  codigo        String    @unique
  descripcion   String
  categoria     String?   // Categoría del catálogo (p. ej. «Freno trasero»)
  tiempos       String?   // Tiempos alternativos en minutos (JSON, p. ej. "[20,45]")
  ordenCatalogo Int       @default(0) // Posición dentro de su categoría
  tiempoDefecto Float     @default(0.5) // Horas por defecto
  precioHoraDefecto Float @default(30)
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  // Relaciones
  agenda        AgendaTrabajo[]
}

// ═══════════════════════════════════════════════════════════════
// AGENDA (Planificación semanal de trabajos, de lunes a viernes)
// ═══════════════════════════════════════════════════════════════
model AgendaTrabajo {
  id            Int      @id @default(autoincrement())
  fecha         String   @default("") // OBSOLETO: las fechas reales están en AgendaBloque
  hora          String   @default("") // OBSOLETO: el inicio real está en AgendaBloque
  operacionId   Int?
  codigo        String?
  descripcion   String
  categoria     String?
  tiempos       String?  // Copia JSON de los tiempos alternativos (minutos) al programar
  minutos       Int      // Duración total (suma de los minutos de sus bloques)
  nota          String?
  posicion      Int      @default(0) // OBSOLETO: el orden lo da el inicio de los bloques
  mecanicoId    Int?     // null = «Sin asignar»
  clienteId     Int?
  ordenId       Int?
  ordenManoObraId Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  operacion     OperacionManoObra? @relation(fields: [operacionId], references: [id], onDelete: SetNull)
  mecanico      Mecanico?          @relation(fields: [mecanicoId], references: [id], onDelete: SetNull)
  cliente       Cliente?           @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  orden         OrdenReparacion?   @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  ordenManoObra OrdenManoObra?     @relation(fields: [ordenManoObraId], references: [id], onDelete: Cascade)
  bloques       AgendaBloque[]

  @@index([fecha])
  @@index([mecanicoId])
  @@index([ordenId])
}

// Trozo de un trabajo dentro de un día (un trabajo partido entre días tiene uno
// por día). `inicio` es la hora del reloj en minutos desde medianoche y
// `minutos` son minutos de trabajo: no cuentan las pausas del horario.
model AgendaBloque {
  id            Int      @id @default(autoincrement())
  trabajoId     Int
  fecha         String   // «AAAA-MM-DD»
  inicio        Int
  minutos       Int
  forzado       Boolean  @default(false) // Se quedó en el día aunque pase de la capacidad

  trabajo       AgendaTrabajo @relation(fields: [trabajoId], references: [id], onDelete: Cascade)

  @@index([fecha])
  @@index([trabajoId])
}

// Personalización de un día concreto (horario, horas máximas y cierre propios,
// comunes a todos los mecánicos). Si no hay fila para una fecha, se usan los
// valores predeterminados.
model AgendaDia {
  fecha         String   @id // «AAAA-MM-DD»
  tramos        String?  // JSON [{inicio,fin}] propio del día; null = predeterminado
  horasMaximas  Float?   // null = predeterminado
  cierre        String?  // 'festivo' | 'vacaciones'; null = abierto
  motivo        String?  // p. ej. «Fiesta mayor»
  updatedAt     DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// PAPELERA (instantáneas de lo borrado, para poder deshacer)
// ═══════════════════════════════════════════════════════════════
model Papelera {
  id            Int       @id @default(autoincrement())
  tipo          String    // cliente, bicicleta, articulo, articulos-lote, orden, material-orden, mano-obra-orden, operacion, mecanico
  descripcion   String    // Texto legible: «Cliente #101 Adam Raga»
  datos         String    // Instantánea del registro (y de lo que cuelga de él) en JSON
  usuario       String?   // Quién lo borró
  createdAt     DateTime  @default(now())

  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════
// COPIAS DE SEGURIDAD
// ═══════════════════════════════════════════════════════════════
model Backup {
  id            Int       @id @default(autoincrement())
  filename      String
  size          Int
  tipo          String    @default("auto") // auto, manual
  createdAt     DateTime  @default(now())
}
