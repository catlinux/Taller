# Copia este fichero a .env y ajusta los valores. NUNCA subas el .env al repositorio.
DATABASE_URL="file:./dev.db"
PORT=3001
# Obligatorio en producción. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
DATA_DIR="./data"
# Opcional. Solo para producción: si la API debe aceptar peticiones desde otro
# origen, indica aquí ese origen (p. ej. https://taller.example.com). Si se deja
# vacío no se monta CORS, porque la web y la API comparten origen.
CORS_ORIGIN=
NODE_ENV=production
